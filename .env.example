# Copy this file to .env. Never commit a real .env file.

# The composed competitor-intelligence application is local-first and requires Ollama.
# The reusable generic RAG foundation can still select Gemini explicitly.
EMBEDDING_PROVIDER=ollama
GENERATION_PROVIDER=ollama

# Gemini credentials and models. Leave the key empty until making a real Gemini call.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite

# Ollama is installed and started separately by the user.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_BATCH_SIZE=32
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=180

# Explicit browser origins allowed to call the local competitor API.
COMPETITOR_API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Repository-relative local paths are shown below. Do not commit machine-specific paths.
DOCUMENTS_DIR=data/documents
VECTOR_STORE_DIR=data/vector_store
COMPETITOR_INDEX_ROOT=data/vector_store/competitors
FINANCIAL_FACTS_PATH=data/private/competitors/financial_facts.csv

CHUNK_SIZE=200
CHUNK_OVERLAP=50
TOP_K=4

# JSON/JSONL extraction configuration.
JSON_EXTRACTION_MODE=auto
JSON_CONTENT_KEYS=content,text,body,description,summary,answer,paragraph,paragraphs
JSON_TITLE_KEYS=title,heading,name,question
JSON_METADATA_KEYS=id,url,author,category,tags,language,status,version,created_at,updated_at
JSON_EXCLUDE_KEYS=embedding,embeddings,vector,vectors,raw_html,base64,image
JSON_MAX_DEPTH=20
JSON_MAX_RECORDS=1000
JSON_MAX_FILE_SIZE_MB=10
JSON_STRICT_MODE=true
